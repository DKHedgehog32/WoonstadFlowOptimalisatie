<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    =============================================
    Woonstad Case Type Selector - Meta XML
    =============================================
    Date: 2025-07-31
    Last Changed: 2025-07-31
    Description:
    Configuration file for the Woonstad Case Type Selector LWC.
    - Exposes the Case.Type picklist for a given RecordTypeId.
    - Can be embedded inside a Flow Screen.
    - Provides selected value back to Flow as an output property.
-->

<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Use org runtime API version -->
    <apiVersion>59.0</apiVersion>

    <!-- Make component available in Flow Screen Builder -->
    <isExposed>true</isExposed>

    <!-- Metadata shown in Flow Builder UI -->
    <masterLabel>Woonstad Case Type Selector</masterLabel>
    <description>Displays Case.Type picklist values for a RecordTypeId, respecting the field default.</description>

    <!-- Target only Flow Screen -->
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <!-- Define component properties available in Flow -->
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- Input: Record Type Id to fetch picklist values -->
            <property name="recordTypeId" 
                      type="String" 
                      label="Record Type Id" 
                      description="RecordTypeId of Case" />

            <!-- Output: Selected Case.Type value -->
            <property name="selectedValue" 
                      type="String" 
                      label="Selected Case Type" 
                      role="outputOnly" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>