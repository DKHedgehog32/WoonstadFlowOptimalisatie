<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Woonstad Flow Choice Buttons</masterLabel>
    <description>Keuzekaarten voor Flow: Naamplaatje aanvragen en Informatie vraag. Layout instelbaar (horizontal of vertical).</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="var_aanvraag"
                      type="String"
                      label="Naamplaatje aanvragen"
                      role="outputOnly"/>
            <property name="var_vraag"
                      type="String"
                      label="Informatie vraag"
                      role="outputOnly"/>
            <property name="layout"
                      type="String"
                      label="Layout"
                      default="horizontal"
                      description="horizontal or vertical card layout"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>