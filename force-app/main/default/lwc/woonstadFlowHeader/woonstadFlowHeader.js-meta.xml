<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    =============================================
    Woonstad Flow Header - Meta XML
    =============================================
    Date: 2025-07-31
    Last Changed: 2025-07-31
    Description:
    Configuration for the Woonstad Flow Header LWC.
    - Allows the component to be placed on a Flow Screen.
    - Provides a configurable title property displayed 
      next to the Woonstad Rotterdam logo.
-->

<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Use the latest supported API version -->
    <apiVersion>60.0</apiVersion>

    <!-- Make the component available for Flow Screens -->
    <isExposed>true</isExposed>

    <!-- Supported target: Flow Screen only -->
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <!-- Define component properties for Flow configuration -->
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- Input property: Title displayed in the header -->
            <property name="title" 
                      type="String" 
                      label="Titel" 
                      description="Titel in de header" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>