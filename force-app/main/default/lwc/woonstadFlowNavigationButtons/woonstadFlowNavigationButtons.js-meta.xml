<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    =============================================
    Woonstad Flow Navigation Buttons - Meta XML
    =============================================
    Date: 2025-07-31
    Last Changed: 2025-07-31
    Description:
    This configuration file defines the exposed 
    properties for the WoonstadFlowNavigationButtons 
    Lightning Web Component so it can be used on 
    Flow screens. It controls which navigation 
    buttons are available in the Flow runtime.
-->

<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- Toggles visibility of the Back button -->
            <property name="showBack" type="Boolean" label="Show Back Button" default="true" />

            <!-- Toggles visibility of the Next button -->
            <property name="showNext" type="Boolean" label="Show Next Button" default="true" />

            <!-- Toggles visibility of the Reset button -->
            <property name="showReset" type="Boolean" label="Show Reset Button" default="true" />

            <!-- Toggles visibility of the Bevestigen (Confirm) button -->
            <property name="showBevestigen" type="Boolean" label="Show Bevestigen Button" default="false" /> 
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>