<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    =============================================
    Nieuwe Zaak Quick Action - Meta XML
    =============================================
    Date: 2025-07-31
    Last Changed: 2025-07-31
    Description:
    Metadata configuration for the Quick Action LWC 
    that wraps the Flow "Screen_Flow_Create_Update_New_Case_V2".
    - Allows launching the Flow as a Quick Action on Account, Case, and Contact records.
-->

<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Nieuwe Zaak Quick Action</masterLabel>
    <description>
        Quick Action wrapper for Screen_Flow_Create_Update_New_Case_V2.
    </description>

    <targets>
        <target>lightning__RecordAction</target>
    </targets>

    <!-- Restrict to Account, Case, and Contact so recordId is always injected -->
    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <objects>
                <object>Account</object>
                <object>Case</object>
                <object>Contact</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>