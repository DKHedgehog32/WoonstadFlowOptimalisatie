<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    =============================================
    Woonstad Flow Supplier - Meta XML
    =============================================
    Date: 2025-08-05
    Last Changed: 2025-08-05
    Description:
    Exposes the component for Flow Screens.
    Allows toggling between Supplier and Account data
    with validation for mandatory address fields.
-->

<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Woonstad Flow Supplier or Account</masterLabel>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">

            <!-- Toggle: true = show account data, false = supplier -->
            <property name="showAccountData" type="Boolean" label="Show Account Data?" role="inputOnly"/>

            <!-- Account context -->
            <property name="accountId" type="String" label="Account Id" role="inputOnly"/>

            <!-- Inputs: Required when showAccountData is true -->
            <property name="shippingStreet" type="String" label="Shipping Street" role="inputOnly"/>
            <property name="shippingPostalCode" type="String" label="Shipping Postal Code" role="inputOnly"/>
            <property name="shippingCity" type="String" label="Shipping City" role="inputOnly"/>

            <!-- Outputs: Supplier information -->
            <property name="klantNaam" type="String" label="Klant Naam" role="outputOnly"/>
            <property name="eigenaar" type="String" label="Eigenaar" role="outputOnly"/>
            <property name="supplierName" type="String" label="Supplier" role="outputOnly"/>
            <property name="supplierEmail" type="String" label="Supplier Email" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>